{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Monterey Configuration File",
    "type": "object",
    "required": ["header", "$schema"],
    "properties": {
        "header": {
            "type": "object",
            "required": ["montereyVersion", "environment"],
            "description": "Header content of a Monterey file, this is not custom.",
            "properties": {
                "montereyVersion": {
                    "type": "string",
                    "pattern": "^v?\\d+\\.\\d+\\.\\d+$",
                    "description": "The version of Monterey this file is compatible with"
                },
                "environment": {
                    "type": "array",
                    "description": "Array of environment variables",
                    "items": {
                        "type": "object",
                        "required": ["name", "value"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "The name of the environment variable"
                            },
                            "value": {
                                "type": "string",
                                "description": "The value of the environment variable"
                            }
                        }
                    }
                },
                "settings": {
                    "type": "object",
                    "description": "Monterey Settings",
                    "properties": {
                        "loadDotenv": {
                            "type": "boolean",
                            "description": "Load's .env files from your cwd"
                        }
                    }
                }
            }
        },
        "$schema": {
            "type": "string",
            "format": "uri",
            "description": "URL to the JSON schema"
        },
        "javascript": {
            "type": "object",
            "properties": {
                "top": {
                    "type": "string",
                    "description": "Implements raw JavaScript code to the top of the file"
                },
                "end": {
                    "type": "string",
                    "description": "Implements raw JavaScript code to the end of the file"
                },
                "async": {
                    "type": "boolean",
                    "description": "Instead of using synchronized function, it uses asynchronous method"
                }
            }
        },
        "variables": {
            "type": "array",
            "description": "Variable list",
            "items": {
                "type": "object",
                "required": ["name", "value", "immutable"],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$",
                        "description": "Variable name following JavaScript naming conventions"
                    },
                    "value": {
                        "description": "The value of the variable"
                    },
                    "immutable": {
                        "type": "boolean",
                        "description": "Whether the variable is constant (true) or can be reassigned (false)"
                    }
                }
            }
        },
        "functions": {
            "type": "array",
            "description": "Function list",
            "items": {
                "type": "object",
                "required": ["name", "parameters", "body"],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$",
                        "description": "Function name following JavaScript naming conventions"
                    },
                    "parameters": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["name", "nullable"],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
                                },
                                "nullable": {
                                    "type": "boolean"
                                }
                            }
                        }
                    },
                    "body": {
                        "type": "object",
                        "properties": {
                            "variables": {
                                "$ref": "#/properties/variables"
                            },
                            "functions": {
                                "$ref": "#/properties/functions"
                            },
                            "return": {
                                "description": "Returns a value",
                                "type": "string"
                            },
                            "raw": {
                              "description": "Raw Javascript Code",
                              "type": "array",
                              "items": {
                                "type": "string",
                                "description": "Raw JavaScript Code"
                              }
                            }
                        }
                    }
                }
            }
        },
        "classes": {
            "type": "array",
            "description": "Class list",
            "items": {
                "type": "object",
                "required": ["name", "constructor", "body"],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$",
                        "description": "Class name following JavaScript naming conventions"
                    },
                    "constructor": {
                        "type": "object",
                        "required": ["paramters"],
                        "properties": {
                            "paramters": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": ["name", "nullable"],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
                                        },
                                        "nullable": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "body": {
                        "type": "object",
                        "properties": {
                            "variables": {
                                "$ref": "#/properties/variables"
                            },
                            "functions": {
                                "$ref": "#/properties/functions"
                            }
                        }
                    }
                }
            }
        }
    }
}
