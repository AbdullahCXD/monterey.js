{
  "name": "monterey.js",
  "version": "1.0.0",
  "description": "A JSON (JavaScript Object Notation) converter/language transpiles to JavaScript",
  "main": "dist/index.js",
  "typings": "./typings/index.d.ts",
  "bin": {
    "monterey": "dist/bin/index.js",
    "monjs": "dist/bin/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "postinstall": "pnpm build",
    "clean:src": "node scripts/cleanJunk.js"
  },
  "keywords": [
    "cli",
    "language",
    "transpiler",
    "json"
  ],
  "author": "AbdullahCXD",
  "license": "MIT",
  "packageManager": "pnpm@10.6.1",
  "dependencies": {
    "@inquirer/confirm": "^5.1.7",
    "@inquirer/prompts": "^7.3.3",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "consola": "^3.4.0",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "listr2": "^8.2.5",
    "lodash": "^4.17.21",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
