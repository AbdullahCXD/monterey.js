{
  "$schema": "../schema/monterey.schema.json",
  "header": {
    "montereyVersion": "1.0.1",
    "environment": [
        {
            "name": "test",
            "value": "helloWorld"
        }
    ],
    "settings": {
        "loadDotenv": false
    }
  },
  "variables": [
    {
      "name": "test",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test1",
      "immutable": false,
      "value": "($env:test)"
    },
    {
      "name": "test2",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test3",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test4",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test6",
      "immutable": true,
      "value": "$testMethod()"
    }
  ],
  "javascript": {
    "async": false,
    "end": "console.log(testMethod())"
  },
  "functions": [
    {
        "name": "testMethod",
        "body": {
            "variables": [
                {
                    "name": "a",
                    "immutable": true,
                    "value": 2
                },
                {
                    "name": "b",
                    "immutable": true,
                    "value": 2
                },
                {
                    "name": "c",
                    "immutable": true,
                    "value": "($globdef:a) + ($globdef:b)"
                }
            ],
            "return": "($globdef:c)"
        },
        "parameters": [
        ]
    }
  ],
  "classes": [
    {
        "name": "TestClass",
        "body": {
            "variables": [],
            "functions": [
                {
                    "name": "invoke",
                    "body": {
                        "variables": [
                            {
                                "name": "name",
                                "immutable": true,
                                "value": "TestFunction"
                            }
                        ]
                    },
                    "parameters": []
                }
            ]
        },
        "constructor": {
            "paramters": []
        }
    }
  ]
}