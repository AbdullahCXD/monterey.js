{
  "$schema": "../schema/monterey.schema.json",
  "header": {
    "montereyVersion": "v1.0.1",
    "environment": [],
    "settings": {
      "loadDotenv": false
    }
  },
  "variables": [
    {
      "name": "test",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test1",
      "immutable": false,
      "value": "helloWorld"
    },
    {
      "name": "test2",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test3",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test4",
      "immutable": false,
      "value": "something"
    },
    {
      "name": "test6",
      "immutable": true,
      "value": "$testMethod()"
    },
    {
      "name": "name",
      "immutable": true,
      "value": "TestFunction"
    }
  ],
  "functions": [
    {
      "name": "testMethod",
      "parameters": [],
      "body": {
        "variables": [
          {
            "name": "a",
            "immutable": true,
            "value": 2
          },
          {
            "name": "b",
            "immutable": true,
            "value": 2
          },
          {
            "name": "c",
            "immutable": true,
            "value": "($globdef:a) + ($globdef:b)"
          }
        ],
        "functions": [],
        "raw": [
          "console.log(c);"
        ],
        "return": "c"
      }
    }
  ],
  "classes": [
    {
      "name": "TestClass",
      "constructor": {
        "paramters": []
      },
      "body": {
        "variables": [],
        "functions": [
          {
            "name": "invoke",
            "parameters": [],
            "body": {
              "variables": [],
              "functions": [],
              "return": "undefined"
            }
          }
        ]
      }
    }
  ]
}
